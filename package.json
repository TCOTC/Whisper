{
  "name": "whisper-theme-builder",
  "version": "3.0.0",
  "private": true,
  "description": "Whisper Theme Building Tool",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node builder/build.mjs --watch",
    "build": "node builder/build.mjs && node builder/zip-package.mjs",
    "lint": "pnpm exec eslint --config builder/eslint.config.mjs",
    "push": "git push origin HEAD --tags"
  },
  "keywords": [
    "siyuan",
    "theme"
  ],
  "author": "Jeffrey Chen",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bestzip": "^3.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "sass": "^1.102.0"
  }
}